# ============================================================
# Integração Instagram (API oficial — Instagram Login / Graph)
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env — apenas este .env.example vai para o git.
# ============================================================

# Token de acesso de longa duração (60 dias) gerado na Meta
INSTAGRAM_ACCESS_TOKEN=

# ID numérico da conta profissional do Instagram autorizada
INSTAGRAM_USER_ID=

# Chave secreta do app na Meta (usada apenas no servidor)
INSTAGRAM_APP_SECRET=

# Segredo que protege a rota de renovação do token (/api/refresh-token).
# Gere um valor aleatório longo. Na Vercel, use exatamente o nome CRON_SECRET
# para que o cron interno envie a autorização automaticamente.
CRON_SECRET=

# ------------------------------------------------------------
# Opcional — renovação 100% automática do token na Vercel.
# Sem estes valores, a rotina renova o token mas o novo valor
# precisa ser colado manualmente no painel da hospedagem.
# ------------------------------------------------------------
# Token de API da Vercel com permissão no projeto
VERCEL_TOKEN=
# ID do projeto na Vercel (Settings → General → Project ID)
VERCEL_PROJECT_ID=
# ID do time na Vercel (apenas se o projeto estiver em um time)
VERCEL_TEAM_ID=
